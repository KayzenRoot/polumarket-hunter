{
  "openapi": "3.0.3",
  "info": {
    "title": "PolyHunter API",
    "version": "0.1.0",
    "description": "Local, single-user, paper-first prediction-market research terminal. No live order endpoint, no wallet and no geoblock bypass. Responses use the {ok, data} or {ok, error} envelope."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Default loopback server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness, provider and geoblock state"
    },
    {
      "name": "state",
      "description": "Dashboard state and event stream"
    },
    {
      "name": "markets",
      "description": "Scanned markets and order books"
    },
    {
      "name": "sessions",
      "description": "Paper sessions and reports"
    },
    {
      "name": "portfolio",
      "description": "Paper portfolio and risk"
    },
    {
      "name": "control",
      "description": "Operator controls"
    },
    {
      "name": "observability",
      "description": "Metrics and the OpenAPI contract"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Engine health",
        "responses": {
          "200": {
            "description": "Engine, provider and geoblock state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Health"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "tags": [
          "state"
        ],
        "summary": "Full dashboard state",
        "responses": {
          "200": {
            "description": "Current paper state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/State"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/stream": {
      "get": {
        "tags": [
          "state"
        ],
        "summary": "Server-sent state stream",
        "description": "Emits `event: state` messages with a JSON state payload and a keep-alive comment every 15 seconds.",
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Recent paper sessions",
        "responses": {
          "200": {
            "description": "Recent sessions",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Session"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "state"
        ],
        "summary": "Recent engine events",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent events",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Event"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/report": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Session report",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session report",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SessionReport"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid session id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/report.csv": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Session report as CSV",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV attachment",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid session id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/markets": {
      "get": {
        "tags": [
          "markets"
        ],
        "summary": "Scanned markets",
        "responses": {
          "200": {
            "description": "Market views",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MarketView"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/markets/{tokenId}": {
      "get": {
        "tags": [
          "markets"
        ],
        "summary": "Market detail and order book",
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Market detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/MarketDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid token id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "404": {
            "description": "Market not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Paper portfolio",
        "responses": {
          "200": {
            "description": "Portfolio snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Portfolio"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/risk": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Risk state",
        "responses": {
          "200": {
            "description": "Risk state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RiskState"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/trades": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Paper fills",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper fills",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Trade"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Strategy signals",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signals",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Signal"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/control": {
      "post": {
        "tags": [
          "control"
        ],
        "summary": "Operate the paper engine",
        "description": "Requires the `x-api-token` header only when the server was started with API_TOKEN. Rate-limited to 10 requests per minute.",
        "security": [
          {},
          {
            "ApiToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Control accepted; returns the new state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/OkEnvelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/State"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid control action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "409": {
            "description": "Control rejected by the engine",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0.3 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Dashboard shell",
        "description": "Serves the built React dashboard, or an API-only fallback when the build is absent.",
        "responses": {
          "200": {
            "description": "HTML dashboard or fallback text",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-token",
        "description": "Required only when API_TOKEN is configured on the server."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Failure": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "OkEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object"
          }
        }
      },
      "Provider": {
        "type": "object",
        "required": [
          "name",
          "connected",
          "lastMessageAt",
          "reconnectCount",
          "error"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "lastMessageAt": {
            "type": "integer",
            "nullable": true
          },
          "reconnectCount": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Geoblock": {
        "type": "object",
        "required": [
          "status",
          "blocked",
          "country",
          "region",
          "checkedAt",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "blocked": {
            "type": "boolean",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "checkedAt": {
            "type": "integer",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "mode",
          "liveAuthorized",
          "liveAllowed",
          "liveBlockReason",
          "startedAt",
          "uptimeMs",
          "markets",
          "subscriptions",
          "books",
          "lastBookAt",
          "provider",
          "geoblock",
          "killReason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "starting",
              "running",
              "paused",
              "stopped",
              "killed",
              "error"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "paper",
              "live"
            ]
          },
          "liveAuthorized": {
            "type": "boolean"
          },
          "liveAllowed": {
            "type": "boolean"
          },
          "liveBlockReason": {
            "type": "string",
            "nullable": true
          },
          "startedAt": {
            "type": "integer",
            "nullable": true
          },
          "uptimeMs": {
            "type": "integer"
          },
          "markets": {
            "type": "integer"
          },
          "subscriptions": {
            "type": "integer"
          },
          "books": {
            "type": "integer"
          },
          "lastBookAt": {
            "type": "integer",
            "nullable": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "geoblock": {
            "$ref": "#/components/schemas/Geoblock"
          },
          "killReason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "status",
          "mode",
          "startingCash",
          "endingEquity",
          "stopReason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "integer"
          },
          "endedAt": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "stopped",
              "killed",
              "error"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "paper",
              "live"
            ]
          },
          "startingCash": {
            "type": "number"
          },
          "endingEquity": {
            "type": "number",
            "nullable": true
          },
          "stopReason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FeeSchedule": {
        "type": "object",
        "required": [
          "rate",
          "exponent",
          "takerOnly",
          "rebateRate"
        ],
        "properties": {
          "rate": {
            "type": "number"
          },
          "exponent": {
            "type": "number"
          },
          "takerOnly": {
            "type": "boolean"
          },
          "rebateRate": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "Market": {
        "type": "object",
        "required": [
          "id",
          "conditionId",
          "slug",
          "question",
          "endDate",
          "liquidity",
          "volume24h",
          "yesTokenId",
          "noTokenId",
          "tickSize",
          "negRisk",
          "active",
          "closed",
          "acceptingOrders"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "conditionId": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "endDate": {
            "type": "string",
            "nullable": true
          },
          "liquidity": {
            "type": "number"
          },
          "volume24h": {
            "type": "number"
          },
          "yesTokenId": {
            "type": "string"
          },
          "noTokenId": {
            "type": "string"
          },
          "tickSize": {
            "type": "number"
          },
          "negRisk": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "closed": {
            "type": "boolean"
          },
          "acceptingOrders": {
            "type": "boolean"
          },
          "feesEnabled": {
            "type": "boolean",
            "nullable": true
          },
          "feeSchedule": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FeeSchedule"
              }
            ],
            "nullable": true
          }
        }
      },
      "BookLevel": {
        "type": "object",
        "required": [
          "price",
          "size"
        ],
        "properties": {
          "price": {
