# PolyHunter runtime configuration.
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Storage. Relative paths are resolved from the repository root.
DATABASE_PATH=data/polyhunter.db
RECORD_DIR=data/recordings

# PAPER ONLY. Live trading is blocked by default and requires BOTH:
#   1) an eligible Polymarket geoblock response, and
#   2) LIVE_TRADING_AUTHORIZED=true plus a future audited live adapter.
# Do not attempt to bypass a venue geoblock.
TRADING_MODE=paper
LIVE_TRADING_AUTHORIZED=false

# Public Polymarket endpoints.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# Market discovery and streaming.
MAX_MARKETS=12
MIN_LIQUIDITY=25000
SCAN_INTERVAL_MS=60000
BOOK_STALE_MS=5000
STREAM_RECONNECT_MAX_MS=30000

# Strategy.
STRATEGY=micro-maker
STARTING_CASH=1000
ORDER_NOTIONAL=10
MIN_EDGE=0.006
MIN_IMBALANCE=0.15
MAX_SPREAD=0.035
MIN_DEPTH_SHARES=100
TAKE_PROFIT_EDGE=0.012
STOP_LOSS_EDGE=0.015
COOLDOWN_MS=2500
ORDER_TTL_MS=15000
FEE_BPS=0

# Risk limits.
MAX_NOTIONAL_PER_MARKET=25
MAX_TOTAL_NOTIONAL=100
MAX_OPEN_POSITIONS=6
MAX_DAILY_LOSS=25
MAX_DRAWDOWN_PCT=0.08
MAX_ORDERS_PER_MINUTE=20

# Demo mode generates deterministic synthetic books instead of connecting to
# Polymarket. Useful for local UI work and CI smoke tests.
DEMO_MODE=false
