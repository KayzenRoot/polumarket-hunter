# Copy to /opt/polyhunter/.env (or /etc/polyhunter/polyhunter.env) and edit.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRADING_MODE=paper
DEMO_MODE=false
DATABASE_PATH=/var/lib/polyhunter/polyhunter.db
RECORD_DIR=/var/lib/polyhunter/recordings
LOG_LEVEL=info

# Set API_TOKEN only if HOST is not loopback. Use a long random value.
# API_TOKEN=
